# bun run init создаёт .env и конфиг CLIProxyAPI со случайными ключами.
# При существующем хабе скопируйте файл в .env и задайте его management key.
PROXCLI_UPSTREAM=http://127.0.0.1:8317
PROXCLI_MANAGEMENT_KEY=
# Только для списка моделей. Это клиентский access key, не management key.
PROXCLI_ACCESS_KEY=
PROXCLI_LISTEN=127.0.0.1:8787
PROXCLI_DATA_DIR=.data
PROXCLI_WEB_DIR=web/dist

# Управление priority для новых сессий; требует ядра из bun run build:core.
PROXCLI_MANAGE_ROUTING=true

# Encrypted session bindings; back up this file together with its .key file.
PROXCLI_AFFINITY_FILE=.data/affinity.enc

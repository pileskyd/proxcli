diff --git a/sdk/cliproxy/auth/proxcli_policy.go b/sdk/cliproxy/auth/proxcli_policy.go
new file mode 100644
index 0000000..41ebc37
--- /dev/null
+++ b/sdk/cliproxy/auth/proxcli_policy.go
@@ -0,0 +1,54 @@
+package auth
+
+import (
+	"strings"
+	"time"
+)
+
+type proxcliConfirmedQuotaAuthIDsKey struct{}
+
+// A generic 429, concurrency limit, auth failure or timeout is not evidence of
+// subscription exhaustion. Provider-attributed subscription errors are explicit.
+func proxcliQuotaResultError(err *Error) bool {
+	if err == nil || statusCodeFromResult(err) != 429 || shouldSkipCredentialCooldown(err) || isTransientRateLimitResultError(err) {
+		return false
+	}
+	text := strings.ToLower(err.Code + " " + err.Message)
+	for _, marker := range []string{"usage_limit_reached", "quota_exhausted", "quota exceeded", "quota exhausted", "usage limit", "weekly limit", "five hour limit", "5-hour limit", "7-day limit", "credential_quota"} {
+		if strings.Contains(text, marker) {
+			return true
+		}
+	}
+	return false
+}
+func proxcliConfirmedQuota(auth *Auth, model string, now time.Time) bool {
+	if auth == nil {
+		return false
+	}
+	live := func(q QuotaState) bool { return q.Exceeded && (q.NextRecoverAt.IsZero() || q.NextRecoverAt.After(now)) }
+	if live(auth.Quota) && (auth.Quota.Reason == "credential_quota" || proxcliQuotaResultError(auth.LastError)) {
+		return true
+	}
+	modelKey := canonicalModelLookupKey(model)
+	for key, state := range auth.ModelStates {
+		if state != nil && canonicalModelLookupKey(key) == modelKey && live(state.Quota) && (state.Quota.Reason == "credential_quota" || proxcliQuotaResultError(state.LastError)) {
+			return true
+		}
+	}
+	return false
+}
+
+// Called with manager.mu held, before leaving the selection snapshot.
+func (m *Manager) proxcliConfirmedQuotaIDs(selector Selector, candidates []*Auth, model string, now time.Time) map[string]struct{} {
+	affinity, ok := selector.(*SessionAffinitySelector)
+	if !ok || !affinity.rebindOnQuotaStrict {
+		return nil
+	}
+	ids := make(map[string]struct{})
+	for _, candidate := range candidates {
+		if candidate != nil && proxcliConfirmedQuota(candidate, m.selectionModelForAuth(candidate, model), now) {
+			ids[candidate.ID] = struct{}{}
+		}
+	}
+	return ids
+}
diff --git a/sdk/cliproxy/auth/proxcli_policy_test.go b/sdk/cliproxy/auth/proxcli_policy_test.go
new file mode 100644
index 0000000..e114ba7
--- /dev/null
+++ b/sdk/cliproxy/auth/proxcli_policy_test.go
@@ -0,0 +1,93 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+func TestProxCliQuotaStrict(t *testing.T) {
+	for _, mode := range []string{"explicit", "lcp"} {
+		for _, tc := range []struct {
+			name     string
+			status   int
+			message  string
+			transfer bool
+		}{
+			{"network", 0, "connection reset", false}, {"server", 500, "upstream overloaded", false}, {"unauthorized", 401, "expired token", false}, {"forbidden", 403, "forbidden", false}, {"rate", 429, "requests per minute", false}, {"quota", 429, "usage_limit_reached", true},
+		} {
+			t.Run(mode+"/"+tc.name, func(t *testing.T) {
+				ctx := context.Background()
+				provider := "openai"
+				model := "gpt-proxcli-test"
+				id := t.Name()
+				high, low := id+"-a", id+"-b"
+				manager := NewManager(nil, nil, nil)
+				statePath := filepath.Join(t.TempDir(), "affinity.enc")
+				affinity := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{StateFile: statePath, Fallback: &FillFirstSelector{}, TTL: 24 * time.Hour, RebindOn: SessionAffinityRebindOnQuotaStrict})
+				defer affinity.Stop()
+				manager.SetSelector(affinity)
+				manager.RegisterExecutor(schedulerTestExecutor{provider: provider})
+				for _, a := range []*Auth{{ID: high, Provider: provider, Status: StatusActive, Attributes: map[string]string{"priority": "2"}}, {ID: low, Provider: provider, Status: StatusActive, Attributes: map[string]string{"priority": "1"}}} {
+					if _, e := manager.Register(WithSkipPersist(ctx), a); e != nil {
+						t.Fatal(e)
+					}
+					registry.GetGlobalRegistry().RegisterClient(a.ID, provider, []*registry.ModelInfo{{ID: model}})
+					t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(a.ID) })
+				}
+				makeOpts := func() cliproxyexecutor.Options {
+					if mode == "lcp" {
+						return cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI, OriginalRequest: []byte(`{"messages":[{"role":"user","content":"keep this conversation on its original account"}]}`), Metadata: map[string]any{cliproxyexecutor.CallerScopeMetadataKey: id}}
+					}
+					return cliproxyexecutor.Options{Headers: http.Header{"X-Session-Id": []string{id}}, Metadata: map[string]any{cliproxyexecutor.DerivedSessionIDMetadataKey: id}}
+				}
+				opts := makeOpts()
+				a, _, e := manager.pickNext(ctx, provider, model, opts, nil)
+				if e != nil || a == nil || a.ID != high {
+					t.Fatalf("cold binding: auth=%v err=%v", a, e)
+				}
+				manager.MarkResult(ctx, Result{AuthID: high, Provider: provider, Model: model, Success: true, Options: opts})
+				opts = makeOpts()
+				a, _, e = manager.pickNext(ctx, provider, model, opts, nil)
+				if e != nil || a == nil || a.ID != high {
+					t.Fatalf("warm binding: auth=%v err=%v", a, e)
+				}
+				manager.MarkResult(ctx, Result{AuthID: high, Provider: provider, Model: model, Error: &Error{HTTPStatus: tc.status, Message: tc.message}, Options: opts})
+				a, _, e = manager.pickNext(ctx, provider, model, makeOpts(), map[string]struct{}{high: {}})
+				if tc.transfer {
+					if e != nil || a == nil || a.ID != low {
+						t.Fatalf("quota must transfer: auth=%v err=%v", a, e)
+					}
+				} else {
+					if e == nil || a != nil {
+						t.Fatalf("non-quota must not execute on another account: auth=%v err=%v", a, e)
+					}
+				}
+				// Recovery of an account with a higher priority never moves a warm binding.
+				expireSessionAffinityPriorityModelCooldown(t, manager, high, model)
+				a, _, e = manager.pickNext(ctx, provider, model, makeOpts(), nil)
+				want := high
+				if tc.transfer {
+					want = low
+				}
+				if e != nil || a == nil || a.ID != want {
+					t.Fatalf("recovery changed binding: auth=%v err=%v want=%s", a, e, want)
+				}
+				restored := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{StateFile: statePath, Fallback: &FillFirstSelector{}, TTL: 24 * time.Hour, RebindOn: SessionAffinityRebindOnQuotaStrict})
+				manager.SetSelector(restored)
+				defer restored.Stop()
+				a, _, e = manager.pickNext(ctx, provider, model, makeOpts(), nil)
+				if e != nil || a == nil || a.ID != want {
+					t.Fatalf("restart lost quota policy binding: %v %v want %s", a, e, want)
+				}
+
+			})
+		}
+	}
+}

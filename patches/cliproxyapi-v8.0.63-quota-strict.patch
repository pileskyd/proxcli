+package session
+
+import "time"
+
+// Only digests and routing identities, never canonical turns or message text.
+type DurablePrefixBinding struct {
+	Namespace, AuthID, SessionID, ParentSessionID, NodeKind, EnvironmentDigest string
+	MinPrefixLength                                                            int
+	IsFork, IsCompaction                                                       bool
+	Fingerprints, TailFingerprints                                             []string
+	ExpiresAt                                                                  time.Time
+}
+
+func (m *MerklePrefixMatcher) ExportBindings() []DurablePrefixBinding {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.prepareLocked()
+	out := []DurablePrefixBinding{}
+	for e := m.lru.Front(); e != nil; e = e.Next() {
+		g := e.Value.(*lcpGroup)
+		if m.now().Before(g.expiresAt) {
+			out = append(out, DurablePrefixBinding{g.namespace, g.authID, g.sessionID, g.parentSessionID, g.nodeKind, g.environmentDigest, g.minPrefixLength, g.isFork, g.isCompaction, append([]string(nil), g.fingerprints...), append([]string(nil), g.tailFingerprints...), g.expiresAt})
+		}
+	}
+	return out
+}
+func (m *MerklePrefixMatcher) RestoreBindings(items []DurablePrefixBinding) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.prepareLocked()
+	now := m.now()
+	for _, g := range items {
+		if g.Namespace == "" || g.AuthID == "" || g.SessionID == "" || !now.Before(g.ExpiresAt) || len(g.Fingerprints) == 0 || len(g.Fingerprints) > m.maxTurns || g.MinPrefixLength < 1 || g.MinPrefixLength > len(g.Fingerprints) {
+			continue
+		}
+		expiry := g.ExpiresAt
+		if limit := now.Add(m.ttl); expiry.After(limit) {
+			expiry = limit
+		}
+		key := sequenceKey(g.Fingerprints)
+		ns := m.namespaceLocked(g.Namespace)
+		if old := ns.groups[key]; old != nil {
+			m.removeGroupLocked(old)
+		}
+		m.addGroupLocked(&lcpGroup{key: key, namespace: g.Namespace, authID: g.AuthID, sessionID: g.SessionID, parentSessionID: g.ParentSessionID, nodeKind: g.NodeKind, environmentDigest: g.EnvironmentDigest, minPrefixLength: g.MinPrefixLength, isFork: g.IsFork, isCompaction: g.IsCompaction, fingerprints: append([]string(nil), g.Fingerprints...), tailFingerprints: append([]string(nil), g.TailFingerprints...), expiresAt: expiry})
+	}
+}

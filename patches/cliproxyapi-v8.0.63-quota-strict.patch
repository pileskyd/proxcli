index 0000000..69fc30e
--- /dev/null
+++ b/sdk/cliproxy/auth/proxcli_state.go
@@ -0,0 +1,269 @@
+package auth
+
+import (
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	exec "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	session "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/session"
+	log "github.com/sirupsen/logrus"
+)
+
+type affinityDisk struct {
+	mu      sync.Mutex
+	path    string
+	key     []byte
+	loadErr error
+	stopped bool
+}
+type affinitySnapshot struct {
+	Version int
+	TTL     time.Duration
+	Cache   []DurableBinding
+	LCP     []session.DurablePrefixBinding
+}
+
+func affinityStorageError() error {
+	return &Error{Code: "session_affinity_storage_error", Message: "Cannot restore or persist session affinity; check the state file and key. No alternate account selected."}
+}
+func (s *SessionAffinitySelector) Pick(ctx context.Context, provider, model string, opts exec.Options, auths []*Auth) (*Auth, error) {
+	if s.disk == nil {
+		return s.pickMemory(ctx, provider, model, opts, auths)
+	}
+	d := s.disk
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.loadErr != nil || d.stopped {
+		return nil, affinityStorageError()
+	}
+	selected, err := s.pickMemory(ctx, provider, model, opts, auths)
+	if e := s.saveAffinity(); e != nil {
+		log.Error("proxcli: cannot persist session affinity")
+		return nil, affinityStorageError()
+	}
+	return selected, err
+}
+func (s *SessionAffinitySelector) OnResult(res Result) {
+	if s == nil {
+		return
+	}
+	if s.disk == nil {
+		s.onResultMemory(res)
+		return
+	}
+	d := s.disk
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.loadErr != nil || d.stopped {
+		return
+	}
+	s.onResultMemory(res)
+	if s.saveAffinity() != nil {
+		log.Error("proxcli: cannot persist session affinity result")
+	}
+}
+func (s *SessionAffinitySelector) initAffinity(path string, ttl time.Duration) {
+	if path == "" {
+		return
+	}
+	d := &affinityDisk{path: path}
+	s.disk = d
+	fail := func() {
+		d.loadErr = affinityStorageError()
+		log.Error("proxcli: cannot restore session affinity; requests will be refused")
+	}
+	data, e := os.ReadFile(path)
+	stateMissing := errors.Is(e, os.ErrNotExist)
+	if e != nil && !errors.Is(e, os.ErrNotExist) {
+		fail()
+		return
+	}
+	if (e == nil && len(data) == 0) || len(data) > 64<<20 {
+		fail()
+		return
+	}
+	key, e := os.ReadFile(path + ".key")
+	if errors.Is(e, os.ErrNotExist) && len(data) == 0 {
+		if e = os.MkdirAll(filepath.Dir(path), 0700); e != nil {
+			fail()
+			return
+		}
+		stateMissing = false
+		key = make([]byte, 32)
+		if _, e = rand.Read(key); e != nil {
+			fail()
+			return
+		}
+		f, err := os.OpenFile(path+".key", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			fail()
+			return
+		}
+		_, e = f.Write(key)
+		if e == nil {
+			e = f.Sync()
+		}
+		ce := f.Close()
+		if e != nil || ce != nil {
+			fail()
+			return
+		}
+	} else if e != nil {
+		fail()
+		return
+	}
+	if stateMissing && e == nil {
+		fail()
+		return
+	}
+	if len(key) != 32 {
+		fail()
+		return
+	}
+	d.key = key
+	if len(data) == 0 {
+		if s.saveAffinity() != nil {
+			fail()
+		}
+		return
+	}
+	block, _ := aes.NewCipher(key)
+	gcm, _ := cipher.NewGCM(block)
+	if len(data) < gcm.NonceSize() {
+		fail()
+		return
+	}
+	plain, e := gcm.Open(nil, data[:gcm.NonceSize()], data[gcm.NonceSize():], []byte("proxcli-affinity-v1"))
+	if e != nil {
+		fail()
+		return
+	}
+	var snapshot affinitySnapshot
+	if json.Unmarshal(plain, &snapshot) != nil || snapshot.Version != 1 {
+		fail()
+		return
+	}
+	// A shorter configured TTL is measured from the last persisted touch,
+	// never from this process's startup time.
+	if snapshot.TTL > 0 && ttl < snapshot.TTL {
+		for i := range snapshot.Cache {
+			snapshot.Cache[i].ExpiresAt = snapshot.Cache[i].ExpiresAt.Add(ttl - snapshot.TTL)
+		}
+		for i := range snapshot.LCP {
+			snapshot.LCP[i].ExpiresAt = snapshot.LCP[i].ExpiresAt.Add(ttl - snapshot.TTL)
+		}
+	}
+	s.cache.RestoreBindings(snapshot.Cache)
+	s.matcher.RestoreBindings(snapshot.LCP)
+}
+func (s *SessionAffinitySelector) saveAffinity() error {
+	d := s.disk
+	snapshot := affinitySnapshot{Version: 1, TTL: s.cache.ttl, Cache: s.cache.ExportBindings(), LCP: s.matcher.ExportBindings()}
+	plain, e := json.Marshal(snapshot)
+	if e != nil {
+		return e
+	}
+	block, e := aes.NewCipher(d.key)
+	if e != nil {
+		return e
+	}
+	gcm, e := cipher.NewGCM(block)
+	if e != nil {
+		return e
+	}
+	nonce := make([]byte, gcm.NonceSize())
+	if _, e = io.ReadFull(rand.Reader, nonce); e != nil {
+		return e
+	}
+	data := gcm.Seal(nonce, nonce, plain, []byte("proxcli-affinity-v1"))
+	if len(data) > 64<<20 {
+		return errors.New("affinity snapshot exceeds limit")
+	}
+	f, e := os.CreateTemp(filepath.Dir(d.path), ".affinity-*")
+	if e != nil {
+		return e
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if e = f.Chmod(0600); e == nil {
+		_, e = f.Write(data)
+	}
+	if e == nil {
+		e = f.Sync()
+	}
+	ce := f.Close()
+	if e == nil {
+		e = ce
+	}
+	if e != nil {
+		return e
+	}
+	if e = os.Rename(name, d.path); e != nil {
+		return e
+	}
+	// Persist the rename where directory fsync is supported (Windows does not support it).
+	if dir, err := os.Open(filepath.Dir(d.path)); err == nil {
+		_ = dir.Sync()
+		_ = dir.Close()
+	}
+	return nil
+}
+
+type DurableBinding struct {
+	AuthID              string
+	ExpiresAt           time.Time
+	Aliases             []string
+	SessionID, Provider string
+	Sequence            uint64
+}
+
+func (c *SessionCache) ExportBindings() []DurableBinding {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+	out := []DurableBinding{}
+	for el := c.evictionOrder.Front(); el != nil; el = el.Next() {
+		g, ok := c.groups[el.Value.(string)]
+		if ok && time.Now().Before(g.expiresAt) {
+			out = append(out, DurableBinding{g.authID, g.expiresAt, append([]string(nil), g.aliases...), g.binding.sessionID, g.binding.provider, g.binding.sequence})
+		}
+	}
+	return out
+}
+func (c *SessionCache) RestoreBindings(items []DurableBinding) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.ensureInitializedLocked()
+	now := time.Now()
+	for _, g := range items {
+		if g.AuthID == "" || !now.Before(g.ExpiresAt) {
+			continue
+		}
+		aliases := compactSessionAliases(mergeSessionAliases(nil, g.Aliases...))
+		if len(aliases) == 0 {
+			continue
+		}
+		expiry := g.ExpiresAt
+		if limit := now.Add(c.ttl); expiry.After(limit) {
+			expiry = limit
+		}
+		previous := []sessionEntry{}
+		for _, a := range aliases {
+			if old, ok := c.entries[a]; ok {
+				previous = append(previous, old)
+			}
+		}
+		c.replaceAliasGroupsLocked(g.AuthID, expiry, aliases, sessionBinding{g.SessionID, g.Provider, g.Sequence}, previous...)
+		if g.Sequence > c.bindingSequence {
+			c.bindingSequence = g.Sequence
+		}
+	}
+}

+package auth
+
+import (
+	"bytes"
+	"context"
+	executor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	translator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"testing"
+	"time"
+)
+
+func durableOpts(lcp, grown bool) executor.Options {
+	o := executor.Options{Metadata: map[string]any{executor.CallerScopeMetadataKey: "caller"}}
+	if !lcp {
+		o.Headers = http.Header{"Session_id": []string{"private-session"}}
+		return o
+	}
+	o.SourceFormat = translator.FormatOpenAI
+	if grown {
+		o.OriginalRequest = []byte(`{"messages":[{"role":"system","content":"stable"},{"role":"user","content":"private-first"},{"role":"assistant","content":"answer"},{"role":"user","content":"continue"}]}`)
+	} else {
+		o.OriginalRequest = []byte(`{"messages":[{"role":"system","content":"stable"},{"role":"user","content":"private-first"}]}`)
+	}
+	return o
+}
+func TestProxCliDurableProcessRestart(t *testing.T) {
+	if path := os.Getenv("PROXCLI_TEST_AFFINITY_STATE"); path != "" {
+		lcp := os.Getenv("PROXCLI_TEST_AFFINITY_MODE") == "lcp"
+		read := os.Getenv("PROXCLI_TEST_AFFINITY_STAGE") == "read"
+		var fallback Selector = lastAuthSelector{}
+		if read {
+			fallback = &FillFirstSelector{}
+		}
+		s := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: fallback, TTL: time.Hour, StateFile: path, RebindOn: SessionAffinityRebindOnQuotaStrict})
+		a, e := s.Pick(context.Background(), "openai", "model", durableOpts(lcp, read), []*Auth{{ID: "auth-a"}, {ID: "auth-b"}})
+		if e != nil || a == nil || a.ID != "auth-b" {
+			t.Fatalf("restart changed account: %v %v", a, e)
+		}
+		// Exit without Stop: durability cannot depend on graceful shutdown.
+		return
+	}
+	for _, mode := range []string{"explicit", "lcp"} {
+		t.Run(mode, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "affinity.enc")
+			for _, stage := range []string{"write", "read"} {
+				cmd := exec.Command(os.Args[0], "-test.run=^TestProxCliDurableProcessRestart$")
+				cmd.Env = append(os.Environ(), "PROXCLI_TEST_AFFINITY_STATE="+path, "PROXCLI_TEST_AFFINITY_MODE="+mode, "PROXCLI_TEST_AFFINITY_STAGE="+stage)
+				if out, e := cmd.CombinedOutput(); e != nil {
+					t.Fatalf("%s: %v %s", stage, e, out)
+				}
+			}
+			raw, _ := os.ReadFile(path)
+			if bytes.Contains(raw, []byte("private-first")) || bytes.Contains(raw, []byte("private-session")) {
+				t.Fatal("plaintext persisted")
+			}
+			if runtime.GOOS != "windows" {
+				for _, p := range []string{path, path + ".key"} {
+					info, _ := os.Stat(p)
+					if info.Mode().Perm() != 0600 {
+						t.Fatal("unsafe file mode")
+					}
+				}
+			}
+		})
+	}
+}
+func TestProxCliDurableCorruptionAndWriteFailure(t *testing.T) {
+	for _, kind := range []string{"corrupt", "empty", "missing-key", "missing-state", "wrong-key", "unwritable"} {
+		t.Run(kind, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "affinity.enc")
+			cfg := SessionAffinityConfig{TTL: time.Hour, StateFile: path, RebindOn: SessionAffinityRebindOnQuotaStrict}
+			s := NewSessionAffinitySelectorWithConfig(cfg)
+			s.Stop()
+			switch kind {
+			case "corrupt":
+				os.WriteFile(path, []byte("bad"), 0600)
+			case "empty":
+				os.WriteFile(path, nil, 0600)
+			case "missing-state":
+				os.Remove(path)
+			case "missing-key":
+				os.Remove(path + ".key")
+			case "wrong-key":
+				os.WriteFile(path+".key", make([]byte, 32), 0600)
+			}
+			s = NewSessionAffinitySelectorWithConfig(cfg)
+			defer s.Stop()
+			if kind == "unwritable" {
+				os.Remove(path)
+				os.Mkdir(path, 0700)
+			}
+			a, e := s.Pick(context.Background(), "openai", "model", durableOpts(false, false), []*Auth{{ID: "a"}})
+			if a != nil || e == nil {
+				t.Fatal("storage failure selected an account")
+			}
+		})
+	}
+}
+func TestProxCliDurableExpiryAndInvalidation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "affinity.enc")
+	cfg := SessionAffinityConfig{TTL: time.Hour, StateFile: path, Fallback: lastAuthSelector{}}
+	s := NewSessionAffinitySelectorWithConfig(cfg)
+	opts := durableOpts(false, false)
+	auths := []*Auth{{ID: "a"}, {ID: "b"}}
+	if _, e := s.Pick(context.Background(), "openai", "model", opts, auths); e != nil {
+		t.Fatal(e)
+	}
+	s.InvalidateAuth("b")
+	s.Stop()
+	cfg.Fallback = &FillFirstSelector{}
+	s = NewSessionAffinitySelectorWithConfig(cfg)
+	a, e := s.Pick(context.Background(), "openai", "model", durableOpts(false, false), auths)
+	if e != nil || a.ID != "a" {
+		t.Fatal("deleted binding resurrected")
+	}
+	s.Stop()
+	// Absolute expiration must include downtime, rather than starting a new TTL at load.
+	cfg.TTL = time.Millisecond
+	s = NewSessionAffinitySelectorWithConfig(cfg)
+	s.Stop()
+	time.Sleep(20 * time.Millisecond)
+	s = NewSessionAffinitySelectorWithConfig(cfg)
+	defer s.Stop()
+	if got := s.cache.ExportBindings(); len(got) != 0 {
+		t.Fatal("expired bindings restored")
+	}
+}
